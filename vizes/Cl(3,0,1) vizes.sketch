block 615.014 461.261 12.126 0 0 0 0 0 0
> Viz(Tri, "Space");
> // A point is a pair of cupped hands where the point is, mirrored when its
> // weight (e123) is negative. A point at infinity has no position, only a
> // direction: it is a ball out at the edge of everything -- bigger, since it
> // is far off, and exempt from the walls' cut.
> vec3 pointOf(Tri t) {
>   vec3 d = vec3(t.e023, t.e013, t.e012);
>   if (abs(t.e123) < 0.000001)
>       return normalize(d + vec3(0.000001)) * 40.0;
>   return d / t.e123;
> }
> void mesh() {
>   for (int i = 0; i < 12; ++i) {
>     float a0 = 3.14159 * float(i) / 12.0;
>     float a1 = 3.14159 * float(i + 1) / 12.0;
>     for (int j = 0; j < 16; ++j) {
>       float b0 = 6.28318 * float(j) / 16.0;
>       float b1 = 6.28318 * float(j + 1) / 16.0;
>       vec3 p00 = vec3(sin(a0) * cos(b0), cos(a0), sin(a0) * sin(b0));
>       vec3 p01 = vec3(sin(a0) * cos(b1), cos(a0), sin(a0) * sin(b1));
>       vec3 p10 = vec3(sin(a1) * cos(b0), cos(a1), sin(a1) * sin(b0));
>       vec3 p11 = vec3(sin(a1) * cos(b1), cos(a1), sin(a1) * sin(b1));
>       emit(p00, p00);
>       emit(p10, p10);
>       emit(p11, p11);
>       emit(p00, p00);
>       emit(p11, p11);
>       emit(p01, p01);
>     }
>   }
> }
> // The ball, only at infinity: anywhere else it folds away to nothing.
> void vert(Tri v, inout vec3 p, inout vec3 n) {
>   if (abs(v.e123) >= 0.000001) {
>     p = pointOf(v);
>     return;
>   }
>   sbUncut = true;
>   p = pointOf(v) + p * 1.32;
> }
> // The hands, anywhere but infinity.
> void mesh2() { model("cupped_hands_pair.obj"); }
> void vert2(Tri v, inout vec3 p, inout vec3 n) {
>   if (abs(v.e123) < 0.000001) {
>     p = pointOf(v);
>     return;
>   }
>   if (v.e123 < 0.0) {
>     p.x = -p.x;
>     n.x = -n.x;
>   }
>   p = pointOf(v) + p * 0.3;
> }
> vec3 position(Tri v) {
>   return pointOf(v);
> }
> float grab(Tri v) {
>   return length(sbScreen(pointOf(v)) - sbPointer);
> }
> // Dragged in the plane through the point that faces the camera.
> Tri drag(Tri v) {
>   vec3 at = pointOf(v);
>   vec3 facing = normalize(sbEye - at);
>   float t = dot(at - sbRayOrigin, facing) / dot(sbRayDir, facing);
>   vec3 to = sbRayOrigin + sbRayDir * t;
>   return Tri(to.z, to.y, to.x, 1.0);
> }
> 
> // A new point: one you can see, somewhere inside the walls, with weight 1.
> Tri example() {
>   vec3 p = mix(sbLimitsMin, sbLimitsMax, vec3(0.1) + 0.8 * vec3(rand(), rand(), rand()));
>   return e123 + p.x * e023 + p.y * e013 + p.z * e012;
> }
end
block -884.083 499.699 15.8141 0 0 0 0 0 0
> Viz(Bi,"Space");
> 
> // A line is a long thin cylinder along it. The mesh is built along y, then
> // turned by a rotor R taking the y axis to the line's direction, and carried
> // to the line's point nearest the origin.
> 
> void mesh() {
>   float cylinderRadius = 0.2195;
>   float cylinderHeight = 21.93;
>   const int radialSegments = 16;
>   for (int i = 0; i < 2; ++i) {
>     float a0 = cylinderHeight * float(i-1);
>     float a1 = cylinderHeight * float(i);
>     for (int j = 0; j < radialSegments; ++j) {
>       float b0 = 6.28318 * float(j) / float(radialSegments);
>       float b1 = 6.28318 * float(j + 1) / float(radialSegments);
>       vec3 p00 = cylinderRadius * vec3(cos(b0), a0, sin(b0));
>       vec3 p01 = cylinderRadius * vec3(cos(b1), a0, sin(b1));
>       vec3 p10 = cylinderRadius * vec3(cos(b0), a1, sin(b0));
>       vec3 p11 = cylinderRadius * vec3(cos(b1), a1, sin(b1));
>       emit(p00, vec3(cos(b0), 0., sin(b0)));
>       emit(p10, vec3(cos(b0), 0., sin(b0)));
>       emit(p11, vec3(cos(b1), 0., sin(b1)));
>       emit(p00, vec3(cos(b0), 0., sin(b0)));
>       emit(p11, vec3(cos(b1), 0., sin(b1)));
>       emit(p01, vec3(cos(b1), 0., sin(b1)));
>     }
>   }
> }
> 
> vec3 getPos(Bi v) {
>   Tri retTri = (e123 | v) ^ (~v);
>   return triToVec3(retTri);
> }
> 
> vec3 position(Bi v) {
>   return getPos(v);
> }
> 
> void vert(Bi v, inout vec3 p, inout vec3 n) {
>   Bi atOrigin = (v|e123) | ~e123;
>   
>   Even rotator = cheapSqrt(atOrigin * ~e13); //could be e31, TODO
>   
>   p = triToVec3(rotator >> triFromVec3(p)) + getPos(v);
>   n = triToVec3(rotator >> triFromVec3(n));
> }
> 
> // A new point: one you can see, somewhere inside the walls, with weight 1.
> Bi example() {
>   vec3 p1 = mix(sbLimitsMin, sbLimitsMax, vec3(0.1) + 0.8 * vec3(rand(), rand(), rand()));
>   vec3 p2 = mix(sbLimitsMin, sbLimitsMax, vec3(0.1) + 0.8 * vec3(rand(), rand(), rand()));
>   return p1 & p2;
> }
end
block -1383.78 0 26 0 0 0 0 0 0
> // helpers
> 
> vec3 triToVec3( in Tri t)  { return vec3(t.e023, t.e013, t.e012) / t.e123; }
> Tri triFromVec3(in vec3 v) { return e123 + v.x * e023 + v.y * e013 + v.z * e012; }
> 
> float spinorNormSq(in Even r) { return (r * ~r).s; }
> Even cheapSqrt(in Even r) {
>   return 1. + r / sqrt(spinorNormSq(r)); 
> }
end
