block -107.808 -230.63 20 0 0 0 0 0 0
> Viz(float, "Axis");
> // A real is a ring on the line, where the number is. The ring is chrome
> // rather than part of the scale, so it is measured in pixels of chrome --
> // sbPixel -- and stays one size however the line is zoomed.
> void mesh() {
>   for (int i = 0; i < 24; ++i) {
>     float s = 6.28318 * float(i) / 24.0;
>     float e = 6.28318 * float(i + 1) / 24.0;
>     emit(vec3(0.0), vec3(0.0, 0.0, 1.0));
>     emit(vec3(7.0 * cos(s), 7.0 * sin(s), 0.0), vec3(0.0, 0.0, 1.0));
>     emit(vec3(7.0 * cos(e), 7.0 * sin(e), 0.0), vec3(0.0, 0.0, 1.0));
>   }
> }
> void vert(float v, inout vec3 p, inout vec3 n) {
>   p = vec3(v, 0.0, 0.0) + p * sbPixel;
> }
> // The hole in it, in the colour of the row.
> void mesh2() {
>   for (int i = 0; i < 24; ++i) {
>     float s = 6.28318 * float(i) / 24.0;
>     float e = 6.28318 * float(i + 1) / 24.0;
>     emit(vec3(0.0), vec3(0.0, 0.0, 1.0));
>     emit(vec3(3.0 * cos(s), 3.0 * sin(s), 0.0), vec3(0.0, 0.0, 1.0));
>     emit(vec3(3.0 * cos(e), 3.0 * sin(e), 0.0), vec3(0.0, 0.0, 1.0));
>   }
> }
> void vert2(float v, inout vec3 p, inout vec3 n) {
>   p = vec3(v, 0.0, 0.0) + p * sbPixel;
> }
> vec4 frag2(float v, vec3 p, vec3 n, vec2 uv) {
>   return vec4(28.0 / 255.0, 28.0 / 255.0, 32.0 / 255.0, 1.0);
> }
> vec3 position(float v) {
>   return vec3(v, 0.0, 0.0);
> }
> // Anywhere up or down the row counts: how far across is what matters.
> float grab(float v) {
>   return abs(sbScreen(position(v)).x - sbPointer.x);
> }
> // Wherever along the line the pointer is.
> float drag(float v) {
>   return sbRayOrigin.x;
> }
> 
> // A new real: a tidy number in [-1, 1), four decimals.
> float example() {
>   return floor((rand() * 2.0 - 1.0) * 10000.0) / 10000.0;
> }
end
block 1268.47 -230.63 20 0 0 0 0 0 0
> Viz(RToR, "Plot");
> // A function of reals is a curve on a plot, input up and output across. A
> // pixel is on it by how near it is, measured square to the curve -- so a
> // steep stretch is as thick as a flat one.
> float gap(vec2 at) {
>   float h = (sbVertical.y - sbVertical.x) * 0.0025;
>   float slope = (value(at.y + h) - value(at.y - h)) / (2.0 * h);
>   return abs(at.x - value(at.y)) / sqrt(1.0 + slope * slope);
> }
> // By how much of the pixel the line covers, not in or out: in or out is a
> // staircase, and nothing but coverage smooths an edge a fragment decides.
> vec4 frag(vec2 at) {
>   float cover = clamp((sbThick - gap(at)) / max(fwidth(at.x), 0.000001) + 0.5, 0.0, 1.0);
>   return vec4(sbTint.rgb, sbTint.a * cover);
> }
> float grab(vec2 at) {
>   return gap(at) / sbPixel;
> }
> // A function nobody wrote: a shape of the input, for each part of the answer.
> float example(float x) {
>   float d = x;
>   return shape(d, rand(), rand());
> }
end
block 1383.78 650 20 0 0 0 0 0 0
> Viz(RToR, "Axis");
> // And a field along a number line: nothing at zero, opaque green at +1 and
> // opaque yellow at -1, clamped beyond -- so a colour means the same number
> // on every axis.
> vec4 frag(vec2 at) {
>   float v = clamp(value(at.x), -1.0, 1.0);
>   vec3 c = vec3(109.0, 205.0, 89.0) / 255.0;
>   if (v < 0.0) c = vec3(253.0, 231.0, 37.0) / 255.0;
>   return vec4(c, abs(v) * sbTint.a);
> }
end
