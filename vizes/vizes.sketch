block 3421.02 -1383.78 20 0 0 0 0 0 0
> Viz(Color, "Picker");
> // A colour on the picker's ring, at its hue. The one the triangle points at is
> // also shown in the triangle, by the picker itself.
> vec3 where(Color c) {
>   float h = hsvOf(c).x * 6.28318;
>   return vec3(0.91 * cos(h), 0.91 * sin(h), 0.0);
> }
> // The colour it is, a disc; and outside a gap, a ring the colour of its
> // variable -- told apart by the texture coordinate, so the two are one piece
> // and a nearer marker is drawn whole over a farther one.
> void mesh() {
>   for (int i = 0; i < 24; ++i) {
>     float s = 6.28318 * float(i) / 24.0;
>     float e = 6.28318 * float(i + 1) / 24.0;
>     vec3 a = vec3(cos(s), sin(s), 0.0);
>     vec3 b = vec3(cos(e), sin(e), 0.0);
>     vec3 n = vec3(0.0, 0.0, 1.0);
>     emit(vec3(0.0), n, vec2(0.0));
>     emit(a * 7.0, n, vec2(0.0));
>     emit(b * 7.0, n, vec2(0.0));
>     emit(a * 9.0, n, vec2(1.0));
>     emit(b * 9.0, n, vec2(1.0));
>     emit(b * 11.5, n, vec2(1.0));
>     emit(a * 9.0, n, vec2(1.0));
>     emit(b * 11.5, n, vec2(1.0));
>     emit(a * 11.5, n, vec2(1.0));
>   }
> }
> // Facing the viewer however the window is turned, one size on screen.
> void vert(Color v, inout vec3 p, inout vec3 n) {
>   p = where(v) + (p.x * sbAcross() + p.y * sbUpward()) * sbPixel;
> }
> vec4 frag(Color v, vec3 p, vec3 n, vec2 uv) {
>   if (uv.x > 0.5) return sbTint;
>   return vec4(clamp(v, 0.0, 1.0), 1.0);
> }
> vec3 position(Color v) {
>   return where(v);
> }
> float grab(Color v) {
>   return length(sbScreen(where(v)) - sbPointer);
> }
> // Round the ring: the hue the pointer is at, the rest as it was.
> Color drag(Color c) {
>   vec3 k = hsvOf(c);
>   return hsv(fract(atan(sbRayOrigin.y, sbRayOrigin.x) / 6.28318), k.y, k.z);
> }
> 
> // A new colour: a bright one, of any hue.
> Color example() {
>   return hsv(rand(), 0.7, 0.9);
> }
end
block 3421.02 153.754 20 0 0 0 0 0 0
> Viz(Color, "Cube");
> // A colour in the RGB cube: red, green and blue along its three edges.
> vec3 where(Color c) {
>   return c - vec3(0.5);
> }
> // The colour it is, a disc; and outside a gap, a ring the colour of its
> // variable -- told apart by the texture coordinate, so the two are one piece
> // and a nearer marker is drawn whole over a farther one.
> void mesh() {
>   for (int i = 0; i < 24; ++i) {
>     float s = 6.28318 * float(i) / 24.0;
>     float e = 6.28318 * float(i + 1) / 24.0;
>     vec3 a = vec3(cos(s), sin(s), 0.0);
>     vec3 b = vec3(cos(e), sin(e), 0.0);
>     vec3 n = vec3(0.0, 0.0, 1.0);
>     emit(vec3(0.0), n, vec2(0.0));
>     emit(a * 7.0, n, vec2(0.0));
>     emit(b * 7.0, n, vec2(0.0));
>     emit(a * 9.0, n, vec2(1.0));
>     emit(b * 9.0, n, vec2(1.0));
>     emit(b * 11.5, n, vec2(1.0));
>     emit(a * 9.0, n, vec2(1.0));
>     emit(b * 11.5, n, vec2(1.0));
>     emit(a * 11.5, n, vec2(1.0));
>   }
> }
> // Facing the viewer however the window is turned, one size on screen.
> void vert(Color v, inout vec3 p, inout vec3 n) {
>   p = where(v) + (p.x * sbAcross() + p.y * sbUpward()) * sbPixel;
> }
> vec4 frag(Color v, vec3 p, vec3 n, vec2 uv) {
>   if (uv.x > 0.5) return sbTint;
>   return vec4(clamp(v, 0.0, 1.0), 1.0);
> }
> vec3 position(Color v) {
>   return where(v);
> }
> float grab(Color v) {
>   return length(sbScreen(where(v)) - sbPointer);
> }
> // In the plane through it that faces the viewer.
> Color drag(Color c) {
>   float t = dot(where(c) - sbRayOrigin, sbRayDir);
>   return sbRayOrigin + sbRayDir * t + vec3(0.5);
> }
end
block 3382.58 1614.41 20 0 0 0 0 0 0
> Viz(Color, "Cylinder");
> // A colour in the HSV cylinder: hue round it, saturation out from the middle,
> // value up.
> vec3 where(Color c) {
>   vec3 k = hsvOf(c);
>   float r = k.y * 0.5;
>   return vec3(r * cos(k.x * 6.28318), k.z - 0.5, r * sin(k.x * 6.28318));
> }
> // The colour it is, a disc; and outside a gap, a ring the colour of its
> // variable -- told apart by the texture coordinate, so the two are one piece
> // and a nearer marker is drawn whole over a farther one.
> void mesh() {
>   for (int i = 0; i < 24; ++i) {
>     float s = 6.28318 * float(i) / 24.0;
>     float e = 6.28318 * float(i + 1) / 24.0;
>     vec3 a = vec3(cos(s), sin(s), 0.0);
>     vec3 b = vec3(cos(e), sin(e), 0.0);
>     vec3 n = vec3(0.0, 0.0, 1.0);
>     emit(vec3(0.0), n, vec2(0.0));
>     emit(a * 7.0, n, vec2(0.0));
>     emit(b * 7.0, n, vec2(0.0));
>     emit(a * 9.0, n, vec2(1.0));
>     emit(b * 9.0, n, vec2(1.0));
>     emit(b * 11.5, n, vec2(1.0));
>     emit(a * 9.0, n, vec2(1.0));
>     emit(b * 11.5, n, vec2(1.0));
>     emit(a * 11.5, n, vec2(1.0));
>   }
> }
> // Facing the viewer however the window is turned, one size on screen.
> void vert(Color v, inout vec3 p, inout vec3 n) {
>   p = where(v) + (p.x * sbAcross() + p.y * sbUpward()) * sbPixel;
> }
> vec4 frag(Color v, vec3 p, vec3 n, vec2 uv) {
>   if (uv.x > 0.5) return sbTint;
>   return vec4(clamp(v, 0.0, 1.0), 1.0);
> }
> vec3 position(Color v) {
>   return where(v);
> }
> float grab(Color v) {
>   return length(sbScreen(where(v)) - sbPointer);
> }
> // In the plane through it that faces the viewer, read back as hue,
> // saturation and value.
> Color drag(Color c) {
>   vec3 q = sbRayOrigin + sbRayDir * dot(where(c) - sbRayOrigin, sbRayDir);
>   float h = fract(atan(q.z, q.x) / 6.28318);
>   return hsv(h, length(vec2(q.x, q.z)) / 0.5, q.y + 0.5);
> }
end
block -1300 -230.63 20 0 0 0 0 0 0
> // What the functions' examples are made of, shared by every viz of a
> // function here.
> // One of four shapes a person would know -- a wave, a parabola, a bump, a
> // line -- and how steep, from two random numbers.
> float shape(float d, float pick, float steep) {
>   float k = 0.6 + 0.1 * floor(steep * 12.0);
>   if (pick < 0.25) return sin(k * d);
>   if (pick < 0.5) return k * d * d - 1.0;
>   if (pick < 0.75) return exp(-k * d * d);
>   return k * d;
> }
end
