block 2421.62 -384.384 20 0 0 0 0 0 0
> Viz(R2ToR, "Surface");
> // A real function of the plane is a landscape, marched from wherever the
> // window has been turned to. sbMarch finds where a ray first meets it.
> vec4 shade(vec2 film, float pixel, out float nearest) {
>   vec3 o, d;
>   sbSurfaceCamera(film, o, d);
>   float t = sbMarch(o, d, pixel, nearest);
>   if (t < 0.0) return vec4(0.0);
>   vec3 hit = o + d * t;
>   return sbPaint(value(vec2(hit.x, hit.z)));
> }
> // Whether a ray hits is yes or no, so an edge is a staircase. A ray that
> // passed near an edge -- sbMarch says how near -- is marched four more times
> // across its pixel, and they are averaged by how much each covered.
> vec4 frag(vec2 film) {
>   vec2 px = vec2(fwidth(film.x), fwidth(film.y));
>   float pixel = px.x * sbHalfSpan();
>   float nearest;
>   vec4 c = shade(film, pixel, nearest);
>   if (nearest >= 1.5) return c;
>   vec4 sum = vec4(0.0);
>   float ignored;
>   for (int k = 0; k < 4; ++k) {
>     vec2 j = vec2(0.375, 0.125);
>     if (k == 1) j = vec2(-0.125, 0.375);
>     if (k == 2) j = vec2(-0.375, -0.125);
>     if (k == 3) j = vec2(0.125, -0.375);
>     vec4 s = shade(film + j * px, pixel, ignored);
>     sum += vec4(s.rgb * s.a, s.a);
>   }
>   if (sum.a <= 0.0) return vec4(0.0);
>   return vec4(sum.rgb / sum.a, sum.a * 0.25);
> }
> // A function nobody wrote: a shape of how far out the point is, for each part of the answer.
> float example(vec2 p) {
>   float d = length(p);
>   return shape(d, rand(), rand());
> }
end
block 2383.18 691.891 20 0 0 0 0 0 0
> Viz(R3ToR, "Volume");
> // A function of space is a cloud, looked through: thick where there is a lot
> // of it, clear where there is none, accumulated front to back so what is
> // nearer hides what is behind. sbClip is where the ray is inside the cube.
> vec4 frag(vec2 film) {
>   vec3 o, d;
>   sbVolumeCamera(film, o, d);
>   vec2 span = sbClip(o, d);
>   if (span.y <= span.x) return vec4(0.0);
>   float step = (span.y - span.x) / 96.0;
>   vec4 acc = vec4(0.0);
>   for (int i = 0; i < 96; ++i) {
>     float v = value(o + d * (span.x + (float(i) + 0.5) * step) - sbHub());
>     float a = 1.0 - exp(-sbThickness(v) * step * 6.0);
>     acc.rgb += (1.0 - acc.a) * sbColourOf(v) * a;
>     acc.a += (1.0 - acc.a) * a;
>     if (acc.a > 0.995) break;
>   }
>   if (acc.a <= 0.002) return vec4(0.0);
>   return vec4(acc.rgb / max(acc.a, 0.0001), acc.a);
> }
> // A function nobody wrote: a shape of how far out the point is, for each part of the answer.
> float example(vec3 p) {
>   float d = length(p);
>   return shape(d, rand(), rand());
> }
end
