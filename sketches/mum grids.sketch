block 307.507 230.63 7.20553 0 0 0 0 0 0 9
> Even simpleExp(Bi b) {
>     float s = b | b;
>     if(abs(s) < .001)
>         return 1. + b + 0. * e1234;
>     else if (s > 0.) {
>         float m = sqrt(s);
>         return cosh(m) + (b * (sinh(m) / m)) + 0. * e1234;
>     }
>     else {
>         float m = sqrt(-s);
>         return cos(m) + (b * (sin(m) / m)) + 0. * e1234;
>     }
> }
> 
> Una cheapNormalize(in Una u){
>   float sn = abs(u|u);
>   return u * (1./(sn == 0. ? 1. : sn));
> }
end
block 1268.47 768.768 26 0 0 0 0 0 0 11
> vec2 rotate45(vec2 p) {
>   float s = 1. / 1.41421356;
>   return s * vec2(p.x - p.y, p.x + p.y);
> }
> 
> vec2 unrotate45(vec2 p) {
>   float s = 1. / 1.41421356;
>   return s * vec2(p.x + p.y, p.y - p.x);
> }
> 
> vec3 mrh(vec2 p) {
>   float m = 18.04;
>   vec2 scaled = unrotate45(p) * m; // grid coordinates: cells are unit squares
> 
>   bool centerSquare = false; // a cell centred on the origin, rather than a corner
>   float offset = centerSquare ? 0.5 : 0.;
>   vec2 shifted = scaled + offset;
>   vec2 cell = floor(shifted);
>   vec2 inCell = shifted - cell; // in [0,1)^2
> 
>   float lineWidth = 0.08;
>   vec2 toEdge = min(inCell, 1. - inCell);
>   bool onGridLine = min(toEdge.x, toEdge.y) < lineWidth;
> 
>   vec2 cellCentre = cell + 0.5 - offset; // back in grid coordinates
> 
>   bool pixelate = true;
>   vec3 val = whole(pixelate ? rotate45(cellCentre / m) : p);
> 
>   return onGridLine ? vec3(0.) : val;
> }
end
