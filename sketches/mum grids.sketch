> Cl(2,2,0);
> //e1e1 = e2e2 = 1
> //e3e3 = e4e4 = -1
> //e2 is space and e3 is time
> //e1 is ep and e4 is em
> 
> float randAt(float i) {return fract(sin(i*12.9898));}
> 
> vec3 whole(vec2 fragPos) {
>     float numLightRaysFloat = 51.29;
>     int numLightRays = 2 * int(0.5*numLightRaysFloat);
>     const float lambda = 0.;
>     const float eoCurvature = 0.5;
>     float eInfCurvature = -6.53; //0.5 is euclidean
>     
>     Una eo = eoCurvature * e1 + (1.-eoCurvature)*e4;  // perceptual infinity
>     Una eInf = eInfCurvature * e1 + (1.-eInfCurvature)*e4;     // actual infinity
>     //eInf = cheapNormalize(eInf);
>     //eo = cheapNormalize(eo);
>     //eInf = e2 + e4; //hack because interested in parabolic
>     // float AdSMultiplier = 0.1;
>     // float multiplier = eInf | eInf > 0. ? 0.25*6.2831853 : eInf | eInf < 0. ? AdSMultiplier : 2.;
>     
>     Even pixelRayTranslator = simpleExp( 0.25 * eo ^ (fragPos.x * e2 + fragPos.y * e3 ) );
>     Bi pixelRay = pixelRayTranslator >> e23;
> 
>     Even boost = cosh(lambda) + e23 * sinh(lambda);
>     Bi middleLightRayA = (e2 + e3) ^ (e1 - e4);
>     Bi middleLightRayB = (e2 - e3) ^ (e1 - e4);
>     //middleLightRayA = (e2 - e4) ^ (e1 + e3); //hack because interested in parabolic
>     //middleLightRayB = (e2 - e4) ^ (e1 - e3);
>     Bi g = eInf ^ e3;
>     bool a = true; //we flip this back and forth
>     float multiplier = 1.;
>     // for(int j = 0; j < 2; ++j)
>     for(int k = 0; k < 2; ++k)
>     for(float i = 0.; i < numLightRays; ++i ) {
>         float t = (i / (numLightRays - fract(numLightRays) - 1.) - 0.5) * 2.; //ranges from -1 to 1
>         // Bi generator = t * 0.5 * 6.2831853 * g;
>         Bi generator = t * multiplier * g;
>         Even lightRayTranslator = simpleExp( generator );
>         
>         Bi lightRay = lightRayTranslator >> (k==0 ? middleLightRayA:middleLightRayB);
>         if(lambda != 0.)
>             lightRay = boost >> lightRay;
>         float val = e1234 | (lightRay ^ pixelRay);
>         bool notAroundUniverse = generator|generator > -1.5707963267948966;
>         if(val > 0 && notAroundUniverse ) {
>             if(a) a = false;
>             else  a = true;
>         }
>     }
>     
>     vec3 aCol = vec3(143./255.,150./255.,160./255.);
>     vec3 bCol = vec3(215./255.,10./255.,62./255.);
>     vec3 ret = a ? aCol : bCol;
>     
>     vec2 fragToXPos1 = fragPos - vec2(1.,0.);
>     vec2 fragToXNeg1 = fragPos - vec2(-1.,0.);
>     // if(length(fragToXPos1) < 0.04 || length(fragToXNeg1) < 0.04)
>     //   ret = vec3(0.,0.,0.);
>     
>     return ret;
> }
hide randAt
