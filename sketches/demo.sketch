> float u;
> float v;
> vec3 ripple(vec2 p) {
>   float r = length(p) * (3.0 + 10.0 * u);
>   float t = 0.5 + 0.5 * cos(r + v);
>   return vec3(t, t * t, 1.0 - t);
> }
val u 0.439152
val v 0.875625
