> Even simpleExp(Bi b) {
>     float s = b | b;
>     if(abs(s) < .001)
>         return 1. + b + 0. * e1234;
>     else if (s > 0.) {
>         float m = sqrt(s);
>         return cosh(m) + (b * (sinh(m) / m)) + 0. * e1234;
>     }
>     else {
>         float m = sqrt(-s);
>         return cos(m) + (b * (sin(m) / m)) + 0. * e1234;
>     }
> }
> 
